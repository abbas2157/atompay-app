  "stickyArea": {
   "x": 2820,
   "y": 4424,
   "w": 340,
   "fill": "orange",
   "text": "Server first: AtomPay's API has no areas endpoint and /api/v1/profile has no area_id yet. Atomshop's customer API already serves GET /api/areas/{city_id} - mirror it."
  },
  "stickyQuote": {
   "x": 2350,
   "y": 6084,
   "w": 340,
   "fill": "red",
   "text": "Server first: /api/v1/calculator and /api/v1/quote still return seller financing (down payment, tenures, markup). Do not ship the calculator, and do not compute the plan in the app, until they return the AtomPay plan: 3 months, no advance, 0% markup."
  },
  "stickyProducts": {
   "x": 2350,
   "y": 6600,
   "w": 340,
   "fill": "blue",
   "text": "Product photos are labelled slots here: every product row's picture lives on atomshop.pk, none on this machine. Real names and prices are from the shared database."
  },
  "stickyKfs": {
   "x": 1410,
   "y": 13788,
   "w": 360,
   "fill": "red",
   "text": "Decision needed: is the 3% processing fee actually charged? If yes, the APR to disclose is 18.5% (effective 20.1%), and '0% markup' alone is not a full disclosure under Apple 3.2.2(ix). If no, APR is 0% and the fee line should go."
  },
  "stickyGallery": {
   "x": 2820,
   "y": 12288,
   "w": 360,
   "fill": "orange",
   "text": "Changed from the handbook (F7): CNIC photos are camera-only. Google Play's personal-loan policy and SECP's digital lending standards both bar photo-gallery access for lending apps, even with consent."
  },
  "stickyTablet": {
   "x": 2760,
   "y": 2744,
   "w": 340,
   "fill": "blue",
   "text": "Adaptive layout. Under 600 dp: bottom bar, one column. 600 to 839 dp: navigation rail, two columns (this board). 840 dp and up: rail, two columns, 3-up products, content capped at 1040. Same tokens and components at every size; landscape follows the same widths."
  },
  "rowStates": {
   "x": 0,
   "y": 17038,
   "text": "States on real screens: loading, error, empty, offline, success",
   "kind": "title1",
   "maxW": 2740
  }
