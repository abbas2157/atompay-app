<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the adaptive app icon on nucleus. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/nucleus</item>
        <!-- The mark on a white disc, as on the launcher icon and the in-app splash. -->
        <item name="android:windowSplashScreenIconBackgroundColor">@color/icon_background</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/nucleus</item>
    </style>
</resources>
